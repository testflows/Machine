"""Install the SDK wheel ./package built, into this interpreter.

    ./install

Replaces an installed testflows.machine. The core the SDK runs on comes from
the TestFlows™ Machine client's installer, not from here.
"""

import argparse
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
DIST_NAME = "testflows_machine"


def main() -> None:
    argparse.ArgumentParser(description=(__doc__ or "").splitlines()[0]).parse_args()
    wheels = sorted((HERE / "dist").glob(f"{DIST_NAME}-*.whl"))
    if len(wheels) != 1:
        raise SystemExit(
            f"Expected one SDK wheel in dist/, found {len(wheels)}.\n"
            "  Build it ./package"
        )
    pip = [sys.executable, "-m", "pip"]
    subprocess.run([*pip, "uninstall", "-y", "testflows.machine"], check=True)
    subprocess.run([*pip, "install", str(wheels[0])], check=True)


if __name__ == "__main__":
    main()
